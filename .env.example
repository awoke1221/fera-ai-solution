# FERA AI Chatbot — DeepSeek API Configuration
# Copy this file and rename to .env.local, then fill in your API key

# Get your DeepSeek API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: specify a different DeepSeek model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat
